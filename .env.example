# BBMKU University File Management System (UFMS)
# Environment Configuration Template

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_key_in_production

# PostgreSQL Database Configuration
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/bbmku_ufms

# File Upload Configuration
MAX_CONTENT_LENGTH=33554432 # 32 MB in bytes
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,jpg,jpeg,png

# Delay & SLA Thresholds (in days)
SLA_DELAY_WARNING_DAYS=3
SLA_DELAY_CRITICAL_DAYS=7
SLA_DELAY_OVERDUE_DAYS=15

# University Details
UNIVERSITY_NAME=Binod Bihari Mahto Koyalanchal University (BBMKU)
UNIVERSITY_LOCATION=Dhanbad, Jharkhand, India
UNIVERSITY_CODE=BBMKU
